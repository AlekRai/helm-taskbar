export struct ColorRow {
    key: string,
    label: string,
    value: string,
    swatch: color,
    modified: bool,
}

export struct PresetItem {
    name: string,
    bar: color,
    accent: color,
    text: color,
}

export struct GridItem {
    icon: image,
    tip: string,
}

export struct RuleRow {
    exe: string,
    title: string,
    icon-name: string,
    app-icon: image,
    icon: image,
}

export struct MonRow {
    title: string,
    show-labels: bool,
    show-clock: bool,
    show-lang: bool,
    show-tray: bool,
    show-services: bool,
    tray-left: bool,
    show-start: bool,
    pins: [GridItem],
}

export struct SvcRow {
    id: string,
    name: string,
    url: string,
    group: int,
    enabled: bool,
    flash: bool,
    adapter: string,
    icon: image,
    has-icon: bool,
    letter: string,
}

export struct RdpRow {
    name: string,
    path: string,
}

export struct SvcOptsUi {
    flash: bool,
    sound: bool,
    sound-name: string,
    settle: int,
    guard: int,
    list: bool,
    preview: bool,
    max: int,
    panel: bool,
    widen: bool,
    stale: int,
    activity: bool,
    threads: bool,
    poll: int,
    badge: int,
    sched-group: int,
    days: int,
    start: int,
    end: int,
    low_memory: bool,
    dev: bool,
    signin: bool,
    signin-sound-name: string,
    avail: bool,
    avail-start: int,
    avail-end: int,
}

export struct TrayApp {
    exe: string,
    icon: image,
    overflow: bool,
}

