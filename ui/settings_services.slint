import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, CheckBox, LineEdit, SpinBox, SectionTitle, Caption, Segmented, Opt } from "settings_widgets.slint";
import { SvcRow, SvcOptsUi } from "settings_types.slint";

// A number option: label + hint, with the spin box.
component NumOpt inherits Opt {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> increment: 1;
    in property <int> value;
    callback edited(int);
    HorizontalLayout {
        SpinBox {
            width: 200px;
            minimum: root.minimum;
            maximum: root.maximum;
            increment: root.increment;
            value: root.value;
            edited(v) => { root.edited(v); }
        }
        Rectangle { }
    }
}

export component ServicesTab inherits Rectangle {
    in property <[SvcRow]> rows;
    in-out property <SvcOptsUi> so;
    callback row-bool(int, string, bool);
    callback row-text(int, string, string);
    callback row-group(int, int);
    callback row-remove(int);
    callback add(string, string, int);
    callback opt-bool(string, bool);
    callback opt-int(string, int);
    callback opt-day(int, bool);
    callback reset();
    property <int> new-group: 0;

    ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: start;

            SectionTitle { text: "Services"; }
            Caption { text: "Name, address and group changes apply the next time the taskbar starts. Enabling, disabling and removing apply at once."; }
            for r[i] in root.rows: Rectangle {
                height: 40px;
                border-radius: 6px;
                background: Theme.hover;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 8px;
                    CheckBox {
                        width: 28px;
                        y: 6px;
                        checked: r.enabled;
                        toggled => { root.row-bool(i, "enabled", self.checked); }
                    }
                    LineEdit {
                        width: 120px;
                        text: r.name;
                        edited(t) => { root.row-text(i, "name", t); }
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        text: r.url;
                        edited(t) => { root.row-text(i, "url", t); }
                    }
                    Segmented {
                        min-width: 0px;
                        pad: 12px;
                        options: ["Personal", "Work"];
                        current: r.group;
                        selected(g) => { root.row-group(i, g); }
                    }
                    CheckBox {
                        width: 66px;
                        y: 6px;
                        text: "Flash";
                        checked: r.flash;
                        toggled => { root.row-bool(i, "flash", self.checked); }
                    }
                    Button { text: "Remove"; clicked => { root.row-remove(i); } }
                }
            }
            Text { color: Theme.text; text: "Add a service"; }
            HorizontalLayout {
                spacing: 8px;
                new-name := LineEdit { width: 140px; placeholder-text: "name"; }
                new-url := LineEdit { horizontal-stretch: 1; placeholder-text: "https://..."; }
                Segmented {
                    min-width: 0px;
                    pad: 12px;
                    options: ["Personal", "Work"];
                    current: root.new-group;
                    selected(g) => { root.new-group = g; }
                }
                Button {
                    text: "Add";
                    clicked => {
                        root.add(new-name.text, new-url.text, root.new-group);
                        new-name.text = "";
                        new-url.text = "";
                    }
                }
            }
            Caption { text: "Services added here show a count from the page title, e.g. \"(3) Inbox\"."; }

            SectionTitle { text: "Schedule"; }
            Opt {
                title: "Only run during set hours";
                hint: "Outside them the group is closed completely: no window, no process, no memory.";
                Segmented {
                    options: ["Off", "Work", "Personal"];
                    current: root.so.sched-group;
                    selected(g) => { root.so.sched-group = g; root.opt-int("sched_group", g); }
                }
            }
            Text { color: Theme.text; text: "Days"; visible: root.so.sched-group > 0; }
            HorizontalLayout {
                visible: root.so.sched-group > 0;
                height: root.so.sched-group > 0 ? self.preferred-height : 0px;
                spacing: 10px;
                for d[i] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: CheckBox {
                    width: 70px;
                    text: d;
                    checked: Math.mod(Math.floor(root.so.days / Math.pow(2, Math.mod(i + 1, 7))), 2) == 1;
                    toggled => { root.opt-day(Math.mod(i + 1, 7), self.checked); }
                }
                Rectangle { }
            }
            HorizontalLayout {
                visible: root.so.sched-group > 0;
                height: root.so.sched-group > 0 ? self.preferred-height : 0px;
                spacing: 20px;
                NumOpt {
                    title: "From (hour)";
                    maximum: 23;
                    value: root.so.start;
                    edited(v) => { root.so.start = v; root.opt-int("sched_start", v); }
                }
                NumOpt {
                    title: "To (hour)";
                    maximum: 24;
                    value: root.so.end;
                    edited(v) => { root.so.end = v; root.opt-int("sched_end", v); }
                }
                Rectangle { }
            }

            SectionTitle { text: "Flashing"; }
            CheckBox {
                text: "Flash when new mail arrives";
                checked: root.so.flash;
                toggled => { root.so.flash = self.checked; root.opt-bool("flash", self.checked); }
            }
            CheckBox {
                text: "Play a sound when new mail arrives";
                checked: root.so.sound;
                toggled => { root.so.sound = self.checked; root.opt-bool("sound", self.checked); }
            }
            Caption { text: "Each service can also be switched off in the list above."; }
            NumOpt {
                title: "Settle time (seconds)";
                hint: "Mail already there when a service starts doesn't flash during this time.";
                maximum: 300;
                value: root.so.settle;
                edited(v) => { root.so.settle = v; root.opt-int("flash_settle", v); }
            }
            NumOpt {
                title: "Hover guard (ms)";
                hint: "A mail list ignores the mouse for this long after opening, so it doesn't stop flashing by accident.";
                maximum: 3000;
                increment: 50;
                value: root.so.guard;
                edited(v) => { root.so.guard = v; root.opt-int("hover_guard", v); }
            }

            SectionTitle { text: "Mail lists"; }
            CheckBox {
                text: "Click a service to list its unread mail";
                checked: root.so.list;
                toggled => { root.so.list = self.checked; root.opt-bool("mail_list", self.checked); }
            }
            CheckBox {
                text: "Preview text on hover";
                checked: root.so.preview;
                toggled => { root.so.preview = self.checked; root.opt-bool("mail_preview", self.checked); }
            }
            NumOpt {
                title: "Most mails listed";
                minimum: 1;
                maximum: 20;
                value: root.so.max;
                edited(v) => { root.so.max = v; root.opt-int("mail_max", v); }
            }
            NumOpt {
                title: "Refresh interval (seconds)";
                hint: "How often Outlook, Messenger and Teams re-read their lists. Gmail never goes below 10.";
                minimum: 1;
                maximum: 120;
                value: root.so.poll;
                edited(v) => { root.so.poll = v; root.opt-int("poll", v); }
            }

            SectionTitle { text: "Mail panel"; }
            CheckBox {
                text: "Open a clicked mail in the panel beside the list";
                checked: root.so.panel;
                toggled => { root.so.panel = self.checked; root.opt-bool("open_in_panel", self.checked); }
            }
            Caption { text: "Off opens it in the service's full window instead."; }
            CheckBox {
                text: "Widen the panel to fit wide mails";
                checked: root.so.widen;
                toggled => { root.so.widen = self.checked; root.opt-bool("panel_widen", self.checked); }
            }

            SectionTitle { text: "Badges"; }
            NumOpt {
                title: "Largest count shown";
                hint: "Above it the badge reads, for example, 9+.";
                minimum: 1;
                maximum: 99;
                value: root.so.badge;
                edited(v) => { root.so.badge = v; root.opt-int("badge_max", v); }
            }

            SectionTitle { text: "Messenger"; }
            NumOpt {
                title: "Ignore reaction-only unread older than (hours)";
                hint: "Messenger sometimes keeps a chat unread after someone only reacted. 0 never ignores.";
                maximum: 720;
                value: root.so.stale;
                edited(v) => { root.so.stale = v; root.opt-int("stale_hours", v); }
            }

            SectionTitle { text: "Teams"; }
            CheckBox {
                text: "Count the Activity badge as well as Chat";
                checked: root.so.activity;
                toggled => { root.so.activity = self.checked; root.opt-bool("teams_activity", self.checked); }
            }
            CheckBox {
                text: "Keep Followed threads open in the background and list them";
                checked: root.so.threads;
                toggled => { root.so.threads = self.checked; root.opt-bool("teams_threads", self.checked); }
            }

            SectionTitle { text: "Developer"; }
            CheckBox {
                text: "Dev mode (DevTools port, applies at next start)";
                checked: root.so.dev;
                toggled => { root.so.dev = self.checked; root.opt-bool("dev", self.checked); }
            }
            HorizontalLayout {
                Button { text: "Reset service options"; clicked => { root.reset(); } }
                Rectangle { }
            }
        }
    }
}
