import { Theme } from "theme.slint";
import { WifiIcon, EthernetIcon, BtIcon, ChevronRight } from "icons.slint";

export struct QItem {
    label: string,
    sub: string,
    active: bool,
    busy: bool,
    id: int,
}

export component ToggleTile inherits Rectangle {
    in property <string> kind;
    in property <string> label;
    in property <string> sub;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <bool> has-more;
    in property <bool> expanded;
    callback toggled();
    callback more();
    height: 72px;
    border-radius: 8px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.on ? (main-ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
        : (main-ta.has-hover ? Theme.tint-hover : Theme.tint);
    animate background { duration: Theme.anim; easing: ease-out; }

    property <color> fg: root.on ? Theme.on-accent : Theme.text;

    main-ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
    Rectangle {
        x: 10px;
        y: 10px;
        width: 24px;
        height: 20px;
        if root.kind == "wifi": WifiIcon { fg: root.fg; x: 0px; y: 3px; }
        if root.kind == "eth": EthernetIcon { fg: root.fg; x: 0px; y: 3px; }
        if root.kind == "bt": BtIcon { fg: root.fg; x: 2px; y: 2px; }
        if root.kind == "lang": Text {
            text: root.sub;
            color: root.fg;
            font-size: 14px;
            font-weight: 700;
        }
    }
    Text {
        x: 10px;
        y: 38px;
        width: parent.width - 20px - (root.has-more ? 14px : 0px);
        text: root.label;
        color: root.fg;
        font-size: 13px;
        overflow: elide;
    }
    Text {
        x: 10px;
        y: 54px;
        width: parent.width - 20px;
        text: root.kind == "lang" ? "" : root.sub;
        color: root.on ? Theme.on-accent.with-alpha(0.69) : Theme.text-dim;
        font-size: 11px;
        overflow: elide;
    }
    if root.has-more: Rectangle {
        x: parent.width - 30px;
        y: 4px;
        width: 26px;
        height: 32px;
        border-radius: 4px;
        background: more-ta.has-hover ? Theme.shade : transparent;
        ChevronRight {
            fg: root.fg;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            angle: root.expanded ? -90deg : 0deg;
        }
        more-ta := TouchArea { clicked => { root.more(); } }
    }
}

export component VolSlider inherits Rectangle {
    in-out property <float> value;
    callback changed(float);
    height: 24px;
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.tint-strong;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        width: 8px + root.value * (parent.width - 16px);
        background: Theme.accent;
    }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: (parent.height - self.height) / 2;
        x: root.value * (parent.width - self.width);
        background: ta.has-hover || ta.pressed ? Theme.accent.brighter(0.2) : Theme.accent;
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.value = clamp((self.mouse-x - 8px) / (root.width - 16px), 0, 1);
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = clamp((self.mouse-x - 8px) / (root.width - 16px), 0, 1);
                root.changed(root.value);
            }
        }
    }
}

export component Row inherits Rectangle {
    in property <QItem> item;
    callback clicked();
    height: 44px;
    border-radius: 6px;
    background: ta.pressed ? Theme.popup-pressed : ta.has-hover ? Theme.popup-hover : transparent;
    animate background { duration: Theme.anim; easing: ease-out; }
    Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: root.item.active ? Theme.accent : transparent;
    }
    Text {
        x: 18px;
        y: root.item.sub == "" ? (parent.height - self.height) / 2 : 6px;
        width: parent.width - 30px;
        text: root.item.label;
        color: Theme.text;
        font-size: 14px;
        overflow: elide;
    }
    if root.item.sub != "": Text {
        x: 18px;
        y: 24px;
        width: parent.width - 30px;
        text: root.item.sub;
        color: Theme.text-dim;
        font-size: 11px;
        overflow: elide;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    if root.item.busy: Rectangle {
        x: 12px;
        y: parent.height - 4px;
        width: parent.width - 24px;
        height: 2px;
        clip: true;
        Rectangle {
            width: parent.width * 0.35;
            x: (Math.mod(animation-tick() / 1.1s, 1.0) * 1.35 - 0.35) * parent.width;
            border-radius: 1px;
            background: Theme.accent;
        }
    }
}

export component ListPanel inherits Rectangle {
    in property <[QItem]> items;
    in property <bool> loading;
    callback item-clicked(int);
    border-radius: 6px;
    background: Theme.tint-faint;
    property <bool> shown: false;
    opacity: root.shown ? 1.0 : 0.0;
    animate opacity { duration: 220ms * Theme.popup-scale; easing: ease-out; }
    init => { root.shown = true; }
    Flickable {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        content-height: root.items.length * 44px;
        for it[i] in root.items: Row {
            y: i * 44px;
            width: parent.width;
            item: it;
            clicked => { root.item-clicked(i); }
        }
    }
    if root.items.length == 0: Text {
        width: parent.width;
        height: parent.height;
        text: root.loading ? "Looking…" : "Nothing found";
        color: Theme.text-dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export struct MixItem {
    name: string,
    icon: image,
    volume: float,
    muted: bool,
}

export component MixRow inherits Rectangle {
    in property <MixItem> item;
    callback volume(float);
    callback mute();
    callback hide();
    height: 52px;
    TouchArea {
        x: 46px;
        y: 0px;
        width: parent.width - 52px;
        height: 22px;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.hide(); }
        }
    }
    Rectangle {
        x: 6px;
        y: 10px;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: mute-ta.pressed ? Theme.popup-pressed : mute-ta.has-hover ? Theme.popup-hover : transparent;
        Image {
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.item.icon;
            opacity: root.item.muted ? 0.35 : 1.0;
        }
        mute-ta := TouchArea { clicked => { root.mute(); } }
    }
    Text {
        x: 46px;
        y: 6px;
        width: parent.width - 52px;
        text: root.item.name;
        color: root.item.muted ? Theme.text-dim : Theme.text;
        font-size: 12px;
        overflow: elide;
    }
    sl := VolSlider {
        x: 46px;
        y: 24px;
        width: parent.width - 46px - 40px;
        value: root.item.volume;
        changed(v) => { root.volume(v); }
    }
    Text {
        x: parent.width - 38px;
        y: 24px;
        width: 32px;
        height: 24px;
        text: round(sl.value * 100);
        color: Theme.text-dim;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component MixPanel inherits Rectangle {
    in property <[MixItem]> items;
    callback volume(int, float);
    callback mute(int);
    callback hide(int);
    border-radius: 6px;
    background: Theme.tint-faint;
    property <bool> shown: false;
    opacity: root.shown ? 1.0 : 0.0;
    animate opacity { duration: 220ms * Theme.popup-scale; easing: ease-out; }
    init => { root.shown = true; }
    Flickable {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        content-height: root.items.length * 52px;
        for it[i] in root.items: MixRow {
            y: i * 52px;
            width: parent.width;
            item: it;
            volume(v) => { root.volume(i, v); }
            mute => { root.mute(i); }
            hide => { root.hide(i); }
        }
    }
    if root.items.length == 0: Text {
        width: parent.width;
        height: parent.height;
        text: "No apps playing sound";
        color: Theme.text-dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

