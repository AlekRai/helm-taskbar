import { Theme } from "theme.slint";

export struct Cell {
    day: int,
    key: int,
    dim: bool,
    today: bool,
    selected: bool,
}

export struct PCell {
    label: string,
    key: int,
    dim: bool,
    selected: bool,
}

component Chevron inherits Rectangle {
    in property <bool> up;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: Theme.button-radius;
    background: ta.pressed ? Theme.popup-pressed : ta.has-hover ? Theme.popup-hover : transparent;
    animate background { duration: Theme.anim; easing: ease-out; }
    Path {
        width: 12px;
        height: 7px;
        viewbox-width: 12;
        viewbox-height: 7;
        commands: root.up ? "M 1 6 L 6 1 L 11 6" : "M 1 1 L 6 6 L 11 1";
        stroke: Theme.text;
        stroke-width: 1.5px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component CalendarView inherits Rectangle {
    background: Theme.popup-bg;

    in-out property <string> header;
    in-out property <string> month-title;
    in-out property <[Cell]> cells;
    in-out property <float> frac;
    in-out property <bool> picker-open;
    in-out property <bool> year-mode;
    in-out property <string> picker-title;
    in-out property <[PCell]> pcells;
    in-out property <float> pfrac;
    in-out property <[string]> weekday-names;

    callback header-clicked();
    callback prev();
    callback next();
    callback title-clicked();
    callback day-clicked(int);
    callback scrolled(length);
    callback pick-cell(int);
    callback picker-step(int);

    property <length> cw: 328px / 7;
    property <length> rh: 42px;

    TouchArea {
        scroll-event(e) => {
            root.scrolled(e.delta-y);
            accept
        }
    }

    // Header: full date; click returns to today.
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 44px;
        border-radius: Theme.button-radius;
        background: header-ta.pressed ? Theme.popup-pressed : header-ta.has-hover ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        Text {
            x: 12px;
            text: root.header;
            color: Theme.text;
            font-size: 18px;
            font-weight: 600;
            vertical-alignment: center;
        }
        header-ta := TouchArea { clicked => { root.header-clicked(); } }
    }

    Rectangle {
        x: 16px;
        y: 58px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.popup-border;
    }

    // Month title row.
    Rectangle {
        x: 8px;
        y: 66px;
        width: 200px;
        height: 36px;
        border-radius: Theme.button-radius;
        background: title-ta.pressed ? Theme.popup-pressed : title-ta.has-hover ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        Text {
            x: 8px;
            text: root.picker-open ? root.picker-title : root.month-title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
        title-ta := TouchArea { clicked => { root.title-clicked(); } }
    }
    Chevron {
        x: parent.width - 8px - 64px - 4px;
        y: 68px;
        up: true;
        clicked => {
            if (root.picker-open) { root.picker-step(-1); } else { root.prev(); }
        }
    }
    Chevron {
        x: parent.width - 8px - 32px;
        y: 68px;
        up: false;
        clicked => {
            if (root.picker-open) { root.picker-step(1); } else { root.next(); }
        }
    }

    // Weekday names.
    for name[i] in root.weekday-names: Text {
        x: 16px + i * root.cw;
        y: 108px;
        width: root.cw;
        height: 22px;
        text: name;
        color: Theme.text-dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Day grid; rows scroll by `frac` of a row.
    Rectangle {
        x: 16px;
        y: 134px;
        width: 328px;
        height: 6 * root.rh;
        clip: true;
        for c[i] in root.cells: Rectangle {
            x: Math.mod(i, 7) * root.cw;
            y: (Math.floor(i / 7) - root.frac) * root.rh;
            width: root.cw;
            height: root.rh;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: c.today ? Theme.accent : cell-ta.has-hover ? Theme.popup-hover : transparent;
                animate background { duration: Theme.anim; easing: ease-out; }
                border-width: c.selected && !c.today ? 2px : 0px;
                border-color: Theme.accent;
                Text {
                    text: c.day;
                    color: c.today ? Theme.on-accent : c.dim ? Theme.text-dim : Theme.text;
                    font-size: 14px;
                    font-weight: c.today ? 600 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            cell-ta := TouchArea { clicked => { root.day-clicked(c.key); } }
        }
    }

    // Month picker overlay.
    if root.picker-open: Rectangle {
        x: 0px;
        y: 106px;
        width: parent.width;
        height: parent.height - 106px;
        background: Theme.popup-bg;
        TouchArea { }
        Rectangle {
            x: 0px;
            y: 12px;
            width: parent.width;
            height: 4 * 72px;
            clip: true;
            for c[i] in root.pcells: Rectangle {
                x: 16px + Math.mod(i, 4) * 82px;
                y: (Math.floor(i / 4) - root.pfrac) * 72px;
                width: 78px;
                height: 68px;
                border-radius: 6px;
                background: c.selected ? Theme.accent
                    : p-ta.pressed ? Theme.popup-pressed : p-ta.has-hover ? Theme.popup-hover : transparent;
                animate background { duration: Theme.anim; easing: ease-out; }
                Text {
                    text: c.label;
                    color: c.selected ? Theme.on-accent : c.dim ? Theme.text-dim : Theme.text;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                p-ta := TouchArea { clicked => { root.pick-cell(c.key); } }
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.popup-border;
        border-radius: 8px;
    }
}
