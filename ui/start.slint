import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct StartItem {
    name: string,
    icon: image,
    id: string,
    pinned: bool,
}

component Shield inherits Path {
    in property <color> tint: Theme.text;
    width: 12px;
    height: 14px;
    viewbox-width: 14;
    viewbox-height: 16;
    commands: "M 7 1 L 13 3 V 8 C 13 11.5 10 13.5 7 15 C 4 13.5 1 11.5 1 8 V 3 Z";
    stroke: root.tint;
    stroke-width: 1.6px;
    fill: transparent;
}

component CtxRow inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 32px;
    Rectangle {
        border-radius: Theme.button-radius;
        background: ta.pressed ? Theme.popup-pressed : ta.has-hover ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        Text { x: 12px; width: parent.width - 24px; text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component PinTile inherits Rectangle {
    in property <StartItem> item;
    callback launch();
    callback unpin();
    callback launch-admin();
    callback context(length, length);
    width: 88px;
    height: 88px;

    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: Theme.button-radius + 2px;
        background: ta.pressed ? Theme.pressed : ta.has-hover || x-ta.has-hover || adm-ta.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
    }
    Image {
        source: root.item.icon;
        width: 36px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: 12px;
    }
    Text {
        x: 4px;
        y: 56px;
        width: parent.width - 8px;
        height: 24px;
        text: root.item.name;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        clicked => { root.launch(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Rectangle {
        visible: ta.has-hover || x-ta.has-hover || adm-ta.has-hover;
        x: 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: adm-ta.has-hover ? Theme.selected-hover : Theme.selected;
        Shield { x: 3px; y: 2px; width: 12px; height: 14px; }
        adm-ta := TouchArea { clicked => { root.launch-admin(); } }
    }
    Rectangle {
        visible: ta.has-hover || x-ta.has-hover || adm-ta.has-hover;
        x: parent.width - 22px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: x-ta.has-hover ? Theme.selected-hover : Theme.selected;
        Text { text: "x"; color: Theme.text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        x-ta := TouchArea { clicked => { root.unpin(); } }
    }
}

component ResultRow inherits Rectangle {
    in property <StartItem> item;
    in property <bool> selected;
    callback launch();
    callback toggle-pin();
    callback launch-admin();
    callback context(length, length);
    height: 44px;

    Rectangle {
        border-radius: Theme.button-radius + 2px;
        background: ta.pressed ? Theme.pressed : root.selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
    }
    Image {
        source: root.item.icon;
        x: 10px;
        y: 8px;
        width: 28px;
        height: 28px;
    }
    Text {
        x: 52px;
        width: parent.width - 52px - 112px;
        height: parent.height;
        text: root.item.name;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        clicked => { root.launch(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Rectangle {
        visible: ta.has-hover || pin-ta.has-hover || adm-ta.has-hover || root.selected;
        x: parent.width - 104px;
        y: 8px;
        width: 28px;
        height: 28px;
        border-radius: Theme.button-radius + 2px;
        background: adm-ta.pressed ? Theme.pressed : adm-ta.has-hover ? Theme.selected-hover : Theme.selected;
        Shield { x: 8px; y: 7px; width: 12px; height: 14px; }
        adm-ta := TouchArea { clicked => { root.launch-admin(); } }
    }
    Rectangle {
        visible: ta.has-hover || pin-ta.has-hover || adm-ta.has-hover || root.selected;
        x: parent.width - 72px;
        y: 8px;
        width: 64px;
        height: 28px;
        border-radius: Theme.button-radius + 2px;
        background: pin-ta.pressed ? Theme.pressed : pin-ta.has-hover ? Theme.selected-hover : Theme.selected;
        Text {
            text: root.item.pinned ? "Unpin" : "Pin";
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        pin-ta := TouchArea { clicked => { root.toggle-pin(); } }
    }
}

component PowerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 32px;
    width: lbl.preferred-width + 24px;
    border-radius: Theme.button-radius + 2px;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.anim; easing: ease-out; }
    lbl := Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component StartPopup inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-surface;
    preferred-width: 560px;
    preferred-height: 620px;
    title: "Helm Start";

    in property <[StartItem]> pinned;
    in property <[StartItem]> results;
    in-out property <string> query;
    in-out property <int> sel;
    callback query-changed(string);
    callback launch(string);
    callback launch-admin(string);
    callback toggle-pin(string);
    callback locate(string);
    callback can-locate(string) -> bool;
    callback power(int);
    in-out property <bool> ctx-open: false;
    property <StartItem> ctx-item;
    property <bool> ctx-locatable: false;
    property <length> ctx-x: 0px;
    property <length> ctx-y: 0px;

    function open-ctx(item: StartItem, x: length, y: length) {
        root.ctx-item = item;
        root.ctx-locatable = root.can-locate(item.id);
        root.ctx-x = x;
        root.ctx-y = y;
        root.ctx-open = true;
    }

    public function focus-search() {
        search.focus();
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            height: 40px;
            border-radius: Theme.button-radius + 2px;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.hover;
            clip: true;
            Text {
                visible: root.query == "";
                x: 14px;
                text: "Search apps";
                color: Theme.text-dim;
                font-size: 14px;
                vertical-alignment: center;
            }
            search := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                text <=> root.query;
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.accent;
                edited => {
                    root.sel = 0;
                    root.query-changed(self.text);
                }
                key-pressed(e) => {
                    if (e.text == Key.DownArrow) {
                        root.sel = min(root.sel + 1, root.results.length - 1);
                        return accept;
                    }
                    if (e.text == Key.UpArrow) {
                        root.sel = max(root.sel - 1, 0);
                        return accept;
                    }
                    if (e.text == Key.Return) {
                        if (root.results.length > 0) {
                            root.launch(root.results[min(root.sel, root.results.length - 1)].id);
                        }
                        return accept;
                    }
                    return reject;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.query == "": VerticalLayout {
                spacing: 8px;
                Text { text: "Pinned"; color: Theme.text; font-size: 14px; font-weight: 600; height: 24px; }
                if root.pinned.length == 0: Text {
                    text: "No pinned apps yet. Search for an app and click Pin.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: ceil(root.pinned.length / 6) * 88px;
                    for item[i] in root.pinned: PinTile {
                        item: item;
                        x: mod(i, 6) * 88px;
                        y: floor(i / 6) * 88px;
                        launch => { root.launch(item.id); }
                        unpin => { root.toggle-pin(item.id); }
                        launch-admin => { root.launch-admin(item.id); }
                        context(x, y) => { root.open-ctx(item, x, y); }
                    }
                }
            }
            if root.query != "": VerticalLayout {
                spacing: 8px;
                Text { text: "Apps"; color: Theme.text; font-size: 14px; font-weight: 600; height: 24px; }
                if root.results.length == 0: Text {
                    text: "No apps found.";
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: root.results.length * 44px;
                    for item[i] in root.results: ResultRow {
                        item: item;
                        y: i * 44px;
                        width: parent.width;
                        selected: i == root.sel;
                        launch => { root.launch(item.id); }
                        toggle-pin => { root.toggle-pin(item.id); }
                        launch-admin => { root.launch-admin(item.id); }
                        context(x, y) => { root.open-ctx(item, x, y); }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.popup-border;
        }
        HorizontalLayout {
            height: 32px;
            alignment: end;
            spacing: 4px;
            PowerButton { text: "Lock"; clicked => { root.power(0); } }
            PowerButton { text: "Sign out"; clicked => { root.power(1); } }
            PowerButton { text: "Sleep"; clicked => { root.power(2); } }
            PowerButton { text: "Restart"; clicked => { root.power(3); } }
            PowerButton { text: "Shut down"; clicked => { root.power(4); } }
        }
    }

    if root.ctx-open: Rectangle {
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.ctx-open = false; }
            }
        }
        Rectangle {
            property <length> h: 8px + (root.ctx-locatable ? 4 : 3) * 32px;
            x: min(root.ctx-x, root.width - 216px);
            y: min(root.ctx-y, root.height - self.h - 4px);
            width: 208px;
            height: self.h;
            border-radius: 8px;
            background: Theme.popup-surface;
            border-width: 1px;
            border-color: Theme.popup-border;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                CtxRow { text: "Open"; clicked => { root.ctx-open = false; root.launch(root.ctx-item.id); } }
                CtxRow { text: "Run as administrator"; clicked => { root.ctx-open = false; root.launch-admin(root.ctx-item.id); } }
                CtxRow {
                    text: root.ctx-item.pinned ? "Unpin from Start" : "Pin to Start";
                    clicked => { root.ctx-open = false; root.toggle-pin(root.ctx-item.id); }
                }
                if root.ctx-locatable: CtxRow { text: "Open file location"; clicked => { root.ctx-open = false; root.locate(root.ctx-item.id); } }
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.popup-border;
        border-radius: 8px;
    }
}
