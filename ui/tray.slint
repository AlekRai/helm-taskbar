import { Theme } from "theme.slint";
import { TrayItem, SvcItem, GroupIcon, CountBadge, MeetingGlyph, SigninGlyph } from "bar.slint";

export component TrayFlyout inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-surface;
    preferred-width: 160px;
    preferred-height: 60px;
    title: "Rust Taskbar Tray";

    in property <[TrayItem]> items;
    in property <int> cols: 4;
    // When set, the flyout lists web services (one row each) instead of tray icons.
    in property <[SvcItem]> svcs;
    // Unread mails shown in a second panel next to the service rows.
    in property <[SvcItem]> mail;
    in property <bool> mail-left;
    in property <length> mail-w: 440px;
    // Row of the service whose mail panel is open, and the mail row currently shown (-1: none).
    in property <int> sel-svc: -1;
    in property <int> sel-mail: -1;
    callback clicked(int, int);
    callback hovered(int, bool);
    callback svc-clicked(int);
    callback svc-hovered(int, bool);
    callback mail-clicked(int);
    callback svc-middle(int);
    callback mail-middle(int);
    callback mail-read(int);
    callback mail-hovered(int, bool);
    property <length> gx: root.mail.length > 0 && root.mail-left ? root.mail-w : 0px;
    property <length> mx: root.mail-left ? 0px : 220px;

    for m[i] in root.mail: Rectangle {
        x: root.mx + 6px;
        y: 6px + i * 34px;
        width: root.mail-w - 12px;
        height: 32px;
        border-radius: Theme.button-radius;
        background: mta.pressed && mta.has-hover ? Theme.popup-pressed : (mta.has-hover || root.sel-mail == i) ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        if root.sel-mail == i: Rectangle {
            x: 0px;
            y: 7px;
            width: 3px;
            height: parent.height - 14px;
            border-radius: 1.5px;
            background: Theme.accent;
        }
        Rectangle {
            visible: m.flashing;
            border-radius: parent.border-radius;
            background: Theme.accent;
            opacity: m.flashing ? 0.15 + 0.35 * (0.5 + 0.5 * Math.sin(animation-tick() / 1.2s * 360deg)) : 0;
        }
        if m.has-icon: Image {
            source: m.icon;
            width: 18px;
            height: 18px;
            x: 10px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            x: 38px;
            width: parent.width - 38px - 42px;
            height: parent.height;
            text: m.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
        mta := TouchArea {
            changed has-hover => { root.mail-hovered(i, self.has-hover); }
            clicked => { root.mail-clicked(i); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle && self.has-hover) { root.mail-middle(i); }
            }
        }
        // Marks the mail read without opening it.
        if m.kind >= 0: Rectangle {
            x: parent.width - 32px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: rta.pressed && rta.has-hover ? Theme.popup-pressed : rta.has-hover ? Theme.popup-border : transparent;
            Text {
                text: "\u{2713}";
                color: Theme.text;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            rta := TouchArea {
                clicked => { root.mail-read(i); }
            }
        }
    }

    if root.mail.length > 0: Rectangle {
        x: root.mail-left ? root.mail-w : 220px;
        y: 8px;
        width: 1px;
        height: parent.height - 16px;
        background: Theme.popup-border;
    }

    for s[i] in root.svcs: Rectangle {
        x: root.gx + 6px;
        y: 6px + i * 34px;
        width: 208px;
        height: 32px;
        border-radius: Theme.button-radius;
        background: sta.pressed && sta.has-hover ? Theme.popup-pressed : (sta.has-hover || root.sel-svc == i) ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        if root.sel-svc == i && root.mail.length > 0: Rectangle {
            x: 0px;
            y: 7px;
            width: 3px;
            height: parent.height - 14px;
            border-radius: 1.5px;
            background: Theme.accent;
        }
        Rectangle {
            visible: s.flashing;
            border-radius: parent.border-radius;
            background: Theme.accent;
            opacity: s.flashing ? 0.15 + 0.35 * (0.5 + 0.5 * Math.sin(animation-tick() / 1.2s * 360deg)) : 0;
        }
        if !s.has-icon: GroupIcon {
            kind: s.kind;
            x: 10px;
            y: (parent.height - self.height) / 2;
        }
        if s.has-icon: Image {
            source: s.icon;
            width: 18px;
            height: 18px;
            x: 10px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            x: 38px;
            width: parent.width - 38px - 64px;
            height: parent.height;
            text: s.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
        if s.signin: SigninGlyph {
            x: 22px;
            y: parent.height - self.height - 3px;
        }
        if s.meeting: MeetingGlyph {
            x: parent.width - 58px;
            y: (parent.height - self.height) / 2;
        }
        CountBadge {
            count: s.count;
            x: parent.width - self.width - 12px;
            y: (parent.height - self.height) / 2;
        }
        sta := TouchArea {
            changed has-hover => { root.svc-hovered(i, self.has-hover); }
            clicked => { root.svc-clicked(i); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle && self.has-hover) { root.svc-middle(i); }
            }
        }
    }

    for item[i] in root.items: Rectangle {
        x: 6px + mod(i, root.cols) * 38px;
        y: 6px + floor(i / root.cols) * 38px;
        width: 36px;
        height: 36px;
        border-radius: Theme.button-radius;
        background: ta.pressed && ta.has-hover ? Theme.popup-pressed : ta.has-hover ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        Image {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: item.icon;
        }
        ta := TouchArea {
            changed has-hover => { root.hovered(i, self.has-hover); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && ta.has-hover) {
                    if (e.button == PointerEventButton.left) { root.clicked(i, 0); }
                    if (e.button == PointerEventButton.right) { root.clicked(i, 1); }
                }
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.popup-border;
        border-radius: 8px;
    }
}

export component TipPopup inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-surface;
    preferred-width: 120px;
    preferred-height: 28px;
    title: "Rust Taskbar Tip";

    in property <string> text;
    out property <length> want-w: min(label.preferred-width, 340px) + 20px;
    out property <length> want-h: label.preferred-height + 14px;

    label := Text {
        x: 10px;
        y: 7px;
        width: min(self.preferred-width, 340px);
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        wrap: word-wrap;
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.popup-border;
        border-radius: 6px;
    }
}
