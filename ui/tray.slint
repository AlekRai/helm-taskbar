import { Theme } from "theme.slint";
import { TrayItem, SvcItem, GroupIcon, CountBadge, MeetingGlyph } from "bar.slint";

export component TrayFlyout inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-surface;
    preferred-width: 160px;
    preferred-height: 60px;
    title: "Rust Taskbar Tray";

    in property <[TrayItem]> items;
    in property <int> cols: 4;
    // When set, the flyout lists web services (one row each) instead of tray icons.
    in property <[SvcItem]> svcs;
    callback clicked(int, int);
    callback hovered(int, bool);
    callback svc-clicked(int);
    callback svc-hovered(int, bool);

    for s[i] in root.svcs: Rectangle {
        x: 6px;
        y: 6px + i * 34px;
        width: parent.width - 12px;
        height: 32px;
        border-radius: Theme.button-radius;
        background: sta.pressed && sta.has-hover ? Theme.popup-pressed : sta.has-hover ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        Rectangle {
            visible: s.flashing;
            border-radius: parent.border-radius;
            background: Theme.accent;
            opacity: 0.15 + 0.35 * (0.5 + 0.5 * Math.sin(animation-tick() / 1.2s * 360deg));
        }
        GroupIcon {
            kind: s.kind;
            x: 10px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            x: 38px;
            width: parent.width - 38px - 64px;
            height: parent.height;
            text: s.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
        if s.meeting: MeetingGlyph {
            x: parent.width - 58px;
            y: (parent.height - self.height) / 2;
        }
        CountBadge {
            count: s.count;
            x: parent.width - self.width - 12px;
            y: (parent.height - self.height) / 2;
        }
        sta := TouchArea {
            changed has-hover => { root.svc-hovered(i, self.has-hover); }
            clicked => { root.svc-clicked(i); }
        }
    }

    for item[i] in root.items: Rectangle {
        x: 6px + mod(i, root.cols) * 38px;
        y: 6px + floor(i / root.cols) * 38px;
        width: 36px;
        height: 36px;
        border-radius: Theme.button-radius;
        background: ta.pressed && ta.has-hover ? Theme.popup-pressed : ta.has-hover ? Theme.popup-hover : transparent;
        animate background { duration: Theme.anim; easing: ease-out; }
        Image {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: item.icon;
        }
        ta := TouchArea {
            changed has-hover => { root.hovered(i, self.has-hover); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && ta.has-hover) {
                    if (e.button == PointerEventButton.left) { root.clicked(i, 0); }
                    if (e.button == PointerEventButton.right) { root.clicked(i, 1); }
                }
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.popup-border;
        border-radius: 8px;
    }
}

export component TipPopup inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-surface;
    preferred-width: 120px;
    preferred-height: 28px;
    title: "Rust Taskbar Tip";

    in property <string> text;
    out property <length> want-w: min(label.preferred-width, 340px) + 20px;
    out property <length> want-h: label.preferred-height + 14px;

    label := Text {
        x: 10px;
        y: 7px;
        width: min(self.preferred-width, 340px);
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        wrap: word-wrap;
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.popup-border;
        border-radius: 6px;
    }
}
